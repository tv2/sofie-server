{
  "name": "alba-server",
  "version": "0.0.0",
  "repository": "git@github.com:tv2/alba-server.git",
  "license": "MIT",
  "scripts": {
    "start": "node dist",
    "build": "tsc --build",
    "build-watch": "tsc --noEmit --watch",
    "watch": "cross-env INEWS_GATEWAY_HOST=ws://localhost:3008 nodemon",
    "test": "jest",
    "test-watch": "jest --watch --coverage",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "validate": "yarn validate-dependencies && yarn validate-fitness",
    "validate-dependencies": "yarn audit --level moderate --groups dependencies --recursive",
    "validate-fitness": "dependency-cruiser --validate ./.dependency-cruiser.js src",
    "clean": "rimraf dist",
    "reset": "rimraf --glob dist node_modules coverage *.log",
    "start-sofie": "yarn --cwd sofie-stack start",
    "start-database": "ts-node ./database/manager/mongo.ts --start",
    "stop-database": "ts-node ./database/manager/mongo.ts --stop",
    "restart-database": "ts-node ./database/manager/mongo.ts --restart",
    "drop-database": "ts-node ./database/manager/mongo.ts --drop",
    "init-replica-set": "ts-node ./database/manager/mongo.ts --initrs",
    "seed-database": "ts-node ./database/manager/mongo.ts --seed",
    "spy-database": "ts-node ./database/manager/mongo.ts --spy",
    "dump-database": "ts-node ./database/manager/mongo.ts --dump"
  },
  "engines": {
    "node": ">=16.20"
  },
  "devDependencies": {
    "@tv2media/eslint-config": "1.0.3",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/got": "^9.6.12",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.9",
    "@types/ws": "^8.5.5",
    "@typestrong/ts-mockito": "^2.6.6",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.10.3",
    "eslint": "^9.29.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1"
  },
  "dependencies": {
    "@tv2media/logger": "^2.0.3",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "got": "11.8.6",
    "mongodb": "^6.1.0",
    "reflect-metadata": "^0.1.13",
    "superfly-timeline": "^9.0.0",
    "ws": "^8.17.1"
  },
  "resolutions": {
    "cookie": ">=0.7.0"
  }
}
